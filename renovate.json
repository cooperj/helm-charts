{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "at any time"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/charts/.+/values\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false
    }
  ]
